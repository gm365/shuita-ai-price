          "name": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "description": "符合条件的店铺总数"
          },
          "offers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "shop": {
                  "type": "string"
                },
                "shop_token": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "price": {
                  "type": "number",
                  "description": "人民币到手价（标价 + 支付手续费）"
                },
                "list_price": {
                  "type": "number"
                },
                "fee": {
                  "type": "number"
                },
                "fee_channel": {
                  "type": "string"
                },
                "usdt_price": {
                  "description": "用 USDT 付款时的价格（比人民币便宜时才有）",
                  "type": "number"
                },
                "usdt_only": {
                  "description": "该店只收 USDT",
                  "type": "boolean"
                },
                "stock": {
                  "type": "string",
                  "enum": [
                    "in_stock",
                    "unknown",
                    "out"
                  ]
                },
                "stock_count": {
                  "type": "number"
                },
                "checked_at": {
                  "type": "string"
                },
                "shop_page": {
                  "type": "string",
                  "description": "水獭上的店铺详情页"
                }
              },
              "required": [
                "shop",
                "shop_token",
                "platform",
                "price",
                "stock",
                "shop_page"
              ],
              "additionalProperties": false
            }
          },
          "url": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          }
        },
        "required": [
          "sku",
          "name",
          "total",
          "offers",
          "url",
          "updated"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
