        "required": [
          "sku"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "description": "MM-DD，北京时间"
                },
                "price": {
                  "type": "number"
                }
              },
              "required": [
                "date",
                "price"
              ],
              "additionalProperties": false
            }
          },
          "first": {
            "type": [
              "number",
              "null"
            ]
          },
          "last": {
            "type": [
              "number",
              "null"
            ]
          },
          "low": {
            "type": [
              "number",
              "null"
            ]
          },
          "high": {
            "type": [
              "number",
              "null"
            ]
          },
          "change_pct": {
            "description": "首日到最新一天的涨跌幅（%）",
            "type": [
              "number",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "sku",
          "name",
          "points",
