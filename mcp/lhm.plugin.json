    {
      "name": "list_shops",
      "title": "列出收录店铺",
      "description": "按在售商品数列出水獭收录的 AI 订阅店铺（卡网、独立站），可按平台筛选；返回店名、平台、在售商品数与水獭上的店铺页。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "default": 10,
            "description": "返回数量，默认 10，最多 30",
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "platform": {
            "description": "按平台过滤，如 ldxp（链动小铺）、aisou、catfk、jrsoft（鲸软）、cardnet、dujiao_next；传错时会列出可选值",
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "符合筛选条件的店铺总数"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shops": {
            "type": "array",
            "items": {
              "type": "object",
