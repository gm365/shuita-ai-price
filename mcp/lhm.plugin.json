{
  "author": "gm365",
  "authorUrl": "https://github.com/gm365",
  "description": "Live verified AI subscription price comparison across 160+ shops on shuita.xyz (ChatGPT, Claude, Gemini, Grok, Cursor). Updated hourly with CNY landed price (incl. fees), USDT pricing, 30-day trends, and 7 read-only structured tools via v1.5.0 query-style JSON slices. No API key needed.",
  "homepage": "https://shuita.xyz",
  "identifier": "gm365-shuita-ai-price",
  "name": "shuita-ai-price",
  "prompts": [],
  "resources": [],
  "tags": [
    "mcp",
    "price-comparison",
    "ai-subscription",
    "chatgpt",
    "claude",
    "gemini",
    "grok",
    "cursor"
  ],
  "tools": [
    {
      "name": "search_products",
      "title": "搜索 AI 订阅产品",
      "description": "按关键词搜索 AI 订阅产品（ChatGPT Plus、Claude Pro、Gemini、Grok、Cursor 等），返回 SKU、店内到手价区间和在售店铺数。支持中英文与常见俗称（如「克劳德」「GPT 会员」）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "搜索关键词，如 'Claude Pro'、'ChatGPT Plus 直充'、'短效'、'Grok Heavy'"
          },
          "limit": {
            "default": 10,
            "description": "返回数量，默认 10，最多 30",
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "approximate": {
            "type": "boolean",
            "description": "true 表示没有全部关键词都命中的产品，返回的是部分命中结果"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "min_price": {
                  "description": "可买最低到手价（人民币，有货优先）",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max_price": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "merchants": {
                  "description": "在售店铺数",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "sku",
                "name",
                "min_price",
                "max_price",
                "merchants",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "updated": {
            "type": "string"
          }
        },
        "required": [
          "total",
          "approximate",
          "products",
          "updated"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_lowest_price",
      "title": "查询产品最低价",
      "description": "查询某个 AI 产品的可买最低价（店内核验的人民币到手价，有货优先）、价格区间、在售店铺数，以及最低价来自哪家店。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "description": "产品 SKU，如 'gpt_plus_short'、'claude_pro'、'grok_heavy'；也接受产品名称。可先用 search_products 查找。"
          }
        },
        "required": [
          "sku"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "min_price": {
            "description": "可买最低到手价（人民币，有货优先）",
            "type": [
              "number",
              "null"
            ]
          },
          "max_price": {
            "type": [
              "number",
              "null"
            ]
          },
          "merchants": {
            "description": "在售店铺数",
            "type": [
              "number",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "blurb": {
            "type": "string"
          },
          "cheapest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "shop": {
                    "type": "string"
                  },
                  "shop_token": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number",
                    "description": "人民币到手价（标价 + 支付手续费）"
                  },
                  "list_price": {
                    "type": "number"
                  },
                  "fee": {
                    "type": "number"
                  },
                  "fee_channel": {
                    "type": "string"
                  },
                  "usdt_price": {
                    "description": "用 USDT 付款时的价格（比人民币便宜时才有）",
                    "type": "number"
                  },
                  "usdt_only": {
                    "description": "该店只收 USDT",
                    "type": "boolean"
                  },
                  "stock": {
                    "type": "string",
                    "enum": [
                      "in_stock",
                      "unknown",
                      "out"
                    ]
                  },
                  "stock_count": {
                    "type": "number"
                  },
                  "checked_at": {
                    "type": "string"
                  },
                  "shop_page": {
                    "type": "string",
                    "description": "水獭上的店铺详情页"
                  }
                },
                "required": [
                  "shop",
                  "shop_token",
                  "platform",
                  "price",
                  "stock",
                  "shop_page"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "最低价对应的店铺；报价数据暂不可用时为 null"
          },
          "updated": {
            "type": "string"
          }
        },
        "required": [
          "sku",
          "name",
          "min_price",
          "max_price",
          "merchants",
          "url",
          "blurb",
          "cheapest",
          "updated"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_offers",
      "title": "查看各店报价",
      "description": "列出某个 AI 产品在各家店铺的报价，按「有货优先、再比到手价」排序：店名、人民币到手价（含支付手续费）、USDT 价、库存与店铺链接。用于回答「哪家店最便宜」「去哪买」。",
