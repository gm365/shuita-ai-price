    {
      "name": "get_price_trend",
      "title": "查询近 30 天价格走势",
      "description": "查询某个 AI 产品近 30 天每天的可买最低价走势（与详情页走势图同口径），返回起止价格、最高最低点和涨跌幅。用于回答「最近是涨还是跌」「现在是不是低点」。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "description": "产品 SKU 或名称，如 'claude_pro'、'gpt_plus_topup'"
